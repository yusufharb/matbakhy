# ==============================================================================
# Marketplace Core — Platform Infrastructure Environment (.env.example)
# ==============================================================================

# Platform Identifier & Display Name
PLATFORM_NAME="NEXUS Marketplace Core"
PLATFORM_SLUG="nexus-marketplace"

# PostgreSQL 16 Credentials (Used by Docker Compose & Backend)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=marketplace_core
POSTGRES_PORT=5432

# Backend API
API_PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/marketplace_core?sslmode=disable

# Frontend
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8080/api/v1

# ------------------------------------------------------------------------------
# The following services are [PLANNED - Phase 6]
# ------------------------------------------------------------------------------

# [PLANNED - Phase 6] Valkey / Redis Cache
# REDIS_PORT=6379

# [PLANNED - Phase 6] NATS Event Bus
# NATS_PORT=4222

# [PLANNED - Phase 6] MinIO S3 Storage
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001
