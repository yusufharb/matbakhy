# ==============================================================================
# Marketplace Core — Backend Environment Configuration
# ==============================================================================

# Server HTTP Port
PORT=8080

# Environment (development | staging | production)
ENV=development

# PostgreSQL Connection String (Host:Port/Database)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/marketplace_core?sslmode=disable

# Database Connection Pool Settings
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_IDLE_TIME=30m

# Valkey / Redis 7 (Caching, 15-min Cart Leases, Rate Limiting)
REDIS_URL=redis://127.0.0.1:6379/0

# NATS JetStream (Event-Driven Bus)
NATS_URL=nats://127.0.0.1:4222

# MinIO / AWS S3 (KYC Documents, Product Images)
S3_ENDPOINT=127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=marketplace-media
S3_USE_SSL=false

# Meilisearch (Arabic & English Full-Text Search)
MEILI_HOST=http://127.0.0.1:7700
MEILI_API_KEY=masterKey

# JWT Secret for Session Signing (Must be 32+ characters in production)
JWT_SECRET=nexus-enterprise-marketplace-secret-change-in-prod-2026
JWT_EXPIRATION_HOURS=24
