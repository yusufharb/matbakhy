# ==============================================================================
# NEXUS Marketplace Core — Production Environment Configuration
# ==============================================================================

# Application Environment
ENV=production
PORT=8080
APP_URL=https://marketplace.example.com
MARKETPLACE_CURRENCY=USD

# Database Configuration (PostgreSQL 16)
POSTGRES_DB=marketplace_core
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_64_CHAR_PASSWORD
DATABASE_URL=postgres://postgres:CHANGE_ME_GENERATE_64_CHAR_PASSWORD@postgres:5432/marketplace_core?sslmode=disable

# Authentication & Cryptographic Security
# Must be at least 32 characters, cryptographically random (e.g. openssl rand -base64 48)
JWT_SECRET=CHANGE_ME_SECURE_JWT_SECRET_AT_LEAST_32_CHARACTERS_LONG_RANDOM

# CORS Whitelist (Comma-separated origins, NO wildcards in production)
CORS_ALLOWED_ORIGINS=https://marketplace.example.com,https://admin.example.com

# Payment Gateway Configuration
# 1. Stripe
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# 2. Regional / Mock Gateway
GATEWAY_WEBHOOK_SECRET=whsec_CHANGE_ME_REGIONAL_HMAC_SECRET

# Cloud Object Storage (Cloudflare R2 or AWS S3)
STORAGE_ENDPOINT=https://<your_account_id>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=CHANGE_ME_R2_ACCESS_KEY
STORAGE_SECRET_KEY=CHANGE_ME_R2_SECRET_KEY
STORAGE_PUBLIC_URL=https://cdn.example.com

# Asynchronous Outbox Worker
OUTBOX_POLL_INTERVAL_SECONDS=3
