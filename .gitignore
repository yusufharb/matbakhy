# ==============================================================================
# Marketplace Core — Master .gitignore
# ==============================================================================

# Compiled Binaries & Build Outputs
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
dist/
dist-ssr/
build/
.next/
out/

# Go Artifacts
*.test
*.out
backend/bin/

# Node Dependencies & Logs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# Environment & Secrets (Never commit credentials)
.env
.env.local
.env.*.local
*.env
!*.env.example

# Database data directories & dumps
pgdata/
*.sql.gz
*.dump

# Operating System Files
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# IDE & Editor Folders
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Temporary test & debug files
*.tmp
test_*.json
patch_*.json
scratch/
