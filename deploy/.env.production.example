# ==============================================================================
# MATBAKHY ENTERPRISE PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to .env before deploying: cp .env.production.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_DB=marketplace_matbakhy
POSTGRES_USER=matbakhy_admin
# IMPORTANT: Generate a strong, random password (minimum 32 characters)
# e.g.: openssl rand -base64 32
POSTGRES_PASSWORD=replace_with_strong_production_db_password_min_32_chars

# ------------------------------------------------------------------------------
# 2. APPLICATION & SECURITY SECRETS
# ------------------------------------------------------------------------------
ENV=production
PORT=8080
MARKETPLACE_CURRENCY=EGP

# JWT Signing Secret (HMAC-SHA256) - MUST BE AT LEAST 32 CHARACTERS
# e.g.: openssl rand -hex 32
JWT_SECRET=replace_with_secure_production_jwt_secret_min_32_characters_random_hex

# CORS Whitelist (comma-separated list of allowed production domains, e.g. "https://matbakhy.eg,https://cooks.matbakhy.eg,https://admin.matbakhy.eg")
CORS_ALLOWED_ORIGINS=https://matbakhy.eg,https://www.matbakhy.eg,https://cooks.matbakhy.eg,https://admin.matbakhy.eg

# ------------------------------------------------------------------------------
# 3. PAYMENT GATEWAY (Stripe / Moyasar / Fawry / Paymob)
# ------------------------------------------------------------------------------
# Webhook signing secret for payment gateway verification
GATEWAY_WEBHOOK_SECRET=replace_with_production_webhook_secret_whsec_xxx
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 4. S3-COMPATIBLE CLOUD OBJECT STORAGE (Cloudflare R2 / AWS S3)
# ------------------------------------------------------------------------------
STORAGE_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=replace_with_r2_or_s3_access_key
STORAGE_SECRET_KEY=replace_with_r2_or_s3_secret_key
STORAGE_PUBLIC_URL=https://cdn.matbakhy.eg

# ------------------------------------------------------------------------------
# 5. FRONTEND PRODUCTION BUILD ARGS
# ------------------------------------------------------------------------------
# Set to relative path '/api/v1' when served behind Nginx reverse proxy
VITE_API_URL=/api/v1
